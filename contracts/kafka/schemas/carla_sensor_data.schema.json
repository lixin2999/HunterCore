{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hunter-core.local/contracts/kafka/schemas/carla_sensor_data.schema.json",
  "title": "HunterCore 仿真回传 carla.{sim_id}.sensor_data",
  "description": "仿真回传面：CARLA / eval-service 按 sim_id 隔离发布状态、遥测、事件、指标、文件通知与产物。消息 key = sim_id；SIL 模式 vehicle_id 允许为 null，data-collector 落库/转发 sensor_file 时使用 SIM-{sim_id}。消费组：data-collector-carla、data-analytics-carla。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sim_id", "timestamp", "seq", "type", "payload"],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "契约版本；不兼容变更升主版本"
    },
    "sim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "description": "仿真会话 ID，必须等于 Topic 中的 {sim_id} 与 Kafka key"
    },
    "vehicle_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "description": "关联实车 ID；SIL 模式为 null"
    },
    "scene_id": {
      "type": ["string", "null"],
      "maxLength": 64,
      "description": "关联场景 ID（UUID 字符串）"
    },
    "timestamp": {
      "type": "number",
      "description": "消息产生时间，Unix epoch 秒（含毫秒小数）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "单 sim_id 内单调递增序号（幂等去重与丢包检测）"
    },
    "type": {
      "type": "string",
      "enum": ["sim_status", "sim_telemetry", "sim_event", "sim_metrics", "sensor_file", "artifact"],
      "description": "回传消息类型；payload 结构由 type 决定"
    },
    "payload": {
      "type": "object",
      "description": "类型相关载荷（见 allOf 条件约束）"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "sim_status"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "pattern": "^(CREATED|LOADING|READY|RUNNING|PAUSED|COMPLETED|FAILED|CANCELED|created|loading|ready|running|paused|completed|failed|canceled)$"
              },
              "progress_percent": {"type": "number", "minimum": 0, "maximum": 100},
              "elapsed_time": {"type": "number", "minimum": 0},
              "total_time": {"type": "number", "minimum": 0},
              "actors_count": {"type": "integer", "minimum": 0},
              "collisions": {"type": "integer", "minimum": 0},
              "lane_invasions": {"type": "integer", "minimum": 0},
              "ego_state": {"type": "object"},
              "message": {"type": "string", "maxLength": 512},
              "updated_at": {"type": "number"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "sim_telemetry"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["pose", "velocity", "steering_angle"],
            "properties": {
              "pose": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "z": {"type": "number"},
                  "yaw": {"type": "number"}
                }
              },
              "twist": {"type": "object"},
              "velocity": {"type": "number"},
              "steering_angle": {"type": "number"},
              "acceleration": {"type": "number"},
              "sim_time": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "sim_event"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["event_id", "event_type", "event_level", "sim_time"],
            "properties": {
              "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "event_type": {"type": "string", "minLength": 1, "maxLength": 64},
              "event_level": {"type": "string", "enum": ["info", "warning", "critical"]},
              "sim_time": {"type": "number", "minimum": 0},
              "description": {"type": "string", "maxLength": 512},
              "data": {"type": "object"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "sim_metrics"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "safety": {"type": "object"},
              "efficiency": {"type": "object"},
              "comfort": {"type": "object"},
              "task": {"type": "object"},
              "success_criteria_result": {"type": "object"},
              "grade": {"type": "string", "maxLength": 16},
              "score": {"type": "number"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "sensor_file"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sensor_type", "bucket", "object_key", "format", "size_bytes", "md5", "sha256"],
            "properties": {
              "sensor_type": {"type": "string", "minLength": 1, "maxLength": 64},
              "bucket": {
                "type": "string",
                "enum": ["hunter-raw-data", "hunter-rosbag", "hunter-video"]
              },
              "object_key": {"type": "string", "minLength": 1, "maxLength": 512},
              "format": {"type": "string", "minLength": 1, "maxLength": 32},
              "size_bytes": {"type": "integer", "minimum": 0},
              "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "data_type": {"type": "string", "enum": ["point_cloud", "camera_image", "rosbag", "video", "other"]},
              "start_time": {"type": "number"},
              "end_time": {"type": "number"},
              "frame_count": {"type": "integer", "minimum": 0},
              "topics": {"type": "array", "items": {"type": "string"}},
              "seq": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "artifact"}}, "required": ["type"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["name", "bucket", "object_key", "size_bytes", "sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 256},
              "bucket": {"type": "string", "minLength": 1, "maxLength": 64},
              "object_key": {"type": "string", "minLength": 1, "maxLength": 512},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "media_type": {"type": "string", "maxLength": 128}
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "schema_version": "1.0.0",
      "sim_id": "sim-20261023-0001",
      "vehicle_id": "HUNTER-001",
      "scene_id": "8f0c2a3e-6c1b-4a7e-9f2d-1b2c3d4e5f60",
      "timestamp": 1724035200.123,
      "seq": 42,
      "type": "sim_status",
      "payload": {
        "status": "RUNNING",
        "progress_percent": 51.7,
        "elapsed_time": 15.5,
        "total_time": 30.0,
        "actors_count": 5,
        "collisions": 0,
        "lane_invasions": 0
      }
    },
    {
      "schema_version": "1.0.0",
      "sim_id": "sim-20261023-0001",
      "vehicle_id": null,
      "scene_id": "8f0c2a3e-6c1b-4a7e-9f2d-1b2c3d4e5f60",
      "timestamp": 1724035201.0,
      "seq": 43,
      "type": "sim_metrics",
      "payload": {
        "safety": {"collision_count": 0},
        "efficiency": {"avg_speed": 1.5},
        "comfort": {"max_acceleration": 0.8},
        "task": {"completion": 1.0},
        "grade": "A",
        "success_criteria_result": {"collision_free": true}
      }
    }
  ]
}
