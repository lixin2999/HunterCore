{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hunter-core.local/contracts/kafka/schemas/analytics_result.schema.json",
  "title": "analytics_result",
  "description": "平台内部 Topic analytics_result 消息（data-analytics Flink/Spark 产出）。消费方：scene-service（实车场景自动提取，设计文档 4.5 节）、上层业务。⚠ 设计文档 5.3 节未给出该消息结构，本契约按 4.5 节所需字段（触发事件、前后各 10 秒数据引用、自车轨迹、周边目标轨迹、环境条件）定义，需人工确认。",
  "type": "object",
  "additionalProperties": false,
  "required": ["vehicle_id", "result_id", "result_type", "window_start", "window_end", "timestamp"],
  "properties": {
    "vehicle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "车辆 ID；同时是 Kafka 消息 key（保证单车辆有序）"
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "分析结果唯一 ID（幂等/去重键之一）"
    },
    "result_type": {
      "enum": ["metric", "corner_case", "report"],
      "description": "结果类型：指标计算 / Corner Case 挖掘 / 报告生成"
    },
    "trigger_event_type": {
      "enum": [
        "harsh_acceleration",
        "harsh_braking",
        "harsh_turning",
        "over_speed",
        "collision_warning",
        "manual_takeover",
        "emergency_stop",
        "battery_low",
        "battery_critical",
        "communication_loss",
        "sensor_fault",
        "perception_fault",
        "planning_fault",
        "control_fault",
        "ota_start",
        "ota_success",
        "ota_failed",
        "ota_rollback"
      ],
      "description": "触发本次分析的事件类型（受控词表，见 contracts/database/enums.md 第 3 节）；corner_case 类型必填"
    },
    "event_level": {
      "enum": ["info", "warning", "critical"],
      "description": "触发事件等级（受控词表，见 enums.md 第 2 节）"
    },
    "window_start": {
      "type": "number",
      "description": "分析窗口起点（Unix epoch 秒，含毫秒小数）"
    },
    "window_end": {
      "type": "number",
      "description": "分析窗口终点（Unix epoch 秒，含毫秒小数）"
    },
    "timestamp": {
      "type": "number",
      "description": "结果生成时间（Unix epoch 秒）"
    },
    "clip": {
      "type": "object",
      "description": "事件前后数据截取窗口（设计文档 4.5 节：截取事件前后各 10 秒数据，不可更改）",
      "additionalProperties": false,
      "required": ["pre_seconds", "post_seconds"],
      "properties": {
        "pre_seconds": { "enum": [10], "description": "事件前截取时长（s），契约固定 10" },
        "post_seconds": { "enum": [10], "description": "事件后截取时长（s），契约固定 10" },
        "data_file_url": {
          "type": "string",
          "description": "截取数据对象地址（MinIO hunter-rosbag / hunter-raw-data），无则省略"
        }
      }
    },
    "data_file_url": {
      "type": "string",
      "description": "分析所依据的数据文件对象地址（MinIO，如 hunter-rosbag 中的 bag 文件）"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "指标键值对（metric 类型）：如 avg_speed / collision_count / perception_latency_ms"
    },
    "ego_trajectory": {
      "type": "array",
      "description": "自车轨迹（4.5 节提取项之一）",
      "items": { "$ref": "#/definitions/trajectory_point" }
    },
    "objects": {
      "type": "array",
      "description": "周边目标轨迹（4.5 节提取项之一）",
      "items": { "$ref": "#/definitions/object_track" }
    },
    "environment": {
      "type": "object",
      "description": "环境条件（4.5 节提取项之一）",
      "additionalProperties": false,
      "properties": {
        "weather": {
          "enum": ["clear", "rainy", "foggy", "night", "backlight"],
          "description": "天气/光照条件（对齐设计文档 4.2.1 环境场景分类）"
        },
        "road_type": { "type": "string", "description": "道路类型（⚠ 取值域待确认，如 urban/highway/parking）" },
        "speed_limit": { "type": "number", "minimum": 0, "description": "限速（m/s）" }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 512,
      "description": "结果摘要（报告类型：报告标题；corner_case：场景描述）"
    }
  },
  "examples": [
    {
      "vehicle_id": "HUNTER-001",
      "result_id": "b7f1c3d2-5a4e-4c9b-8f2d-1e0a3b5c7d90",
      "result_type": "corner_case",
      "trigger_event_type": "harsh_braking",
      "event_level": "warning",
      "window_start": 1724035190.123,
      "window_end": 1724035220.456,
      "timestamp": 1724035221.789,
      "clip": {
        "pre_seconds": 10,
        "post_seconds": 10,
        "data_file_url": "s3://hunter-rosbag/events/HUNTER-001/1724035200.bag"
      },
      "data_file_url": "s3://hunter-raw-data/HUNTER-001/1724035200_lidar.pcd",
      "metrics": {
        "min_deceleration": -3.42,
        "min_ttc": 1.18,
        "avg_speed": 1.52
      },
      "ego_trajectory": [
        { "timestamp": 1724035190.123, "x": 125.34, "y": 67.89, "z": 0.32, "heading": 1.234, "velocity": 1.52 },
        { "timestamp": 1724035200.123, "x": 126.12, "y": 68.41, "z": 0.32, "heading": 1.236, "velocity": 0.31 }
      ],
      "objects": [
        {
          "object_id": "obj-1024",
          "type": "vehicle",
          "trajectory": [
            { "timestamp": 1724035190.123, "x": 130.2, "y": 67.9, "heading": 1.23, "velocity": 0.0 },
            { "timestamp": 1724035200.123, "x": 130.1, "y": 68.0, "heading": 1.24, "velocity": 0.0 }
          ]
        }
      ],
      "environment": { "weather": "rainy", "road_type": "urban", "speed_limit": 5.0 },
      "description": "雨天城市道路前车急刹，自车最大减速度 3.42 m/s²，最小 TTC 1.18 s"
    },
    {
      "vehicle_id": "HUNTER-002",
      "result_id": "3c9d0e51-7b28-4f6a-9d10-2b4c6e8f0a12",
      "result_type": "metric",
      "trigger_event_type": "manual_takeover",
      "event_level": "info",
      "window_start": 1724035300.0,
      "window_end": 1724035360.0,
      "timestamp": 1724035361.5,
      "metrics": {
        "avg_perception_latency_ms": 85.4,
        "avg_planning_latency_ms": 45.1,
        "manual_takeover_count": 1
      },
      "environment": { "weather": "clear" },
      "description": "60 秒窗口算法时延指标"
    }
  ],
  "definitions": {
    "trajectory_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "x", "y", "heading", "velocity"],
      "properties": {
        "timestamp": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "description": "航向角（rad）" },
        "velocity": { "type": "number", "description": "速度（m/s）" }
      }
    },
    "object_track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "type", "trajectory"],
      "properties": {
        "object_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["vehicle", "pedestrian", "other"],
          "description": "目标类型（与遥测 perception.object_types 域一致）"
        },
        "trajectory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/trajectory_point" }
        }
      }
    }
  }
}
