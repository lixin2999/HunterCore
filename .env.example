# =====================================================================
# HunterEdge 环境变量模板
# 使用：复制为 .env 后按需修改；生产环境非敏感配置走 ConfigMap，敏感配置走 K8s Secret
# =====================================================================

# ---------- 服务基础 ----------
ENVIRONMENT=dev                 # dev / test / staging / prod
LOG_LEVEL=INFO                  # DEBUG / INFO / WARNING / ERROR
DEBUG=true

# ---------- PostgreSQL 15 + TimescaleDB 2.13 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hunter
POSTGRES_PASSWORD=hunter_dev_123
POSTGRES_DB=hunter_edge

# ---------- Kafka 3.6 ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 本地开发 PLAINTEXT；生产环境及车端接入必须 SASL_SSL + SCRAM-SHA-512（设计文档约束）
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=

# ---------- Redis 7 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MinIO（S3 兼容对象存储） ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ---------- 认证与安全（生产必须通过 K8s Secret 覆盖，禁止使用默认值） ----------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120   # Access Token 2h（设计文档：安全机制）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7       # Refresh Token 7d
