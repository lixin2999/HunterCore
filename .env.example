# =====================================================================
# HunterCore 环境变量模板
# 使用：复制为 .env 后按需修改；生产环境非敏感配置走 ConfigMap，敏感配置走 K8s Secret
# 服务私有配置（scene-service）见文件末尾「服务私有配置」小节
# 单机 docker compose 部署（/opt/hunter-edge）请使用 infra/deploy/.env.example
#   —— 该模板包含中间件（PG/Kafka/Redis/MinIO/ZooKeeper/SRS/Flink）、端口映射、
#      远程操控与 SRS 相关变量，以及全部 CHANGE_ME_* 口令占位符
# =====================================================================

# ---------- 服务基础 ----------
ENVIRONMENT=dev                 # dev / test / staging / prod
LOG_LEVEL=INFO                  # DEBUG / INFO / WARNING / ERROR
DEBUG=true

# ---------- PostgreSQL 15 + TimescaleDB 2.13 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hunter
POSTGRES_PASSWORD=hunter_dev_123
POSTGRES_DB=hunter_core

# ---------- Kafka 3.6 ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 本地开发 PLAINTEXT；生产环境及车端接入必须 SASL_SSL + SCRAM-SHA-512（设计文档约束）
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=

# ---------- Kafka 生产/消费契约行为（契约 topics.yaml#producer_defaults / consumer-groups.yaml#defaults） ----------
# 契约目录（含 topics.yaml / consumer-groups.yaml / schemas）；留空 = 自动探测仓库 contracts/kafka
# 容器/K8s 部署需将 contracts/kafka 以 ConfigMap 挂载后指向该路径
KAFKA_CONTRACT_DIR=
# 生产重试与指数退避（契约 retries=3；仅对 broker 可重试错误生效）
KAFKA_PRODUCE_MAX_ATTEMPTS=3
KAFKA_PRODUCE_RETRY_BACKOFF_MS=100
KAFKA_PRODUCE_RETRY_BACKOFF_MAX_MS=5000
# 本地磁盘缓冲（网络中断时落盘，容量上限固定 1GB = 契约 producer_defaults.local_disk_buffer_bytes）
KAFKA_LOCAL_BUFFER_ENABLED=true
KAFKA_LOCAL_BUFFER_DIR=./data/kafka-buffer      # K8s 需挂载 emptyDir/PVC 并纳入配额
KAFKA_LOCAL_BUFFER_MAX_BYTES=1073741824
KAFKA_LOCAL_BUFFER_SEGMENT_MAX_RECORDS=1000
# 消费：handler 重试（耗尽 → {topic}.dlq）、幂等缓存、消费积压指标
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_BACKOFF_MS=200
KAFKA_CONSUMER_IDEMPOTENCY_CACHE_SIZE=10000
KAFKA_CONSUMER_IDEMPOTENCY_TTL_S=86400
KAFKA_CONSUMER_LAG_METRICS_ENABLED=true

# ---------- Redis 7 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MinIO（S3 兼容对象存储） ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ---------- 认证与安全（生产必须通过 K8s Secret 覆盖，禁止使用默认值） ----------
JWT_SECRET_KEY=change-me-in-production
# G-02：网关→后端身份头 X-Internal-MAC 签名密钥（≥32 字节随机串，网关与全部后端服务共用；prod 必填 fail-fast）
GATEWAY_HMAC_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30    # Access Token 30min（G-04① 收紧，原设计文档 2h）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7       # Refresh Token 7d

# =====================================================================
# 服务私有配置：scene-service（端口 8081；生产走 ConfigMap scene-service-config）
# 本地直连服务时按需启用；键名与契约 x-hunter-service.required_env 一一对应
# =====================================================================
SERVICE_NAME=scene-service
API_PORT=8081

# ---------- MinIO（场景资源，契约固定 bucket 与生命周期） ----------
MINIO_BUCKET_SCENE_ASSETS=hunter-scene-assets
MINIO_REGION=us-east-1
SCENE_EXPORT_OBJECT_PREFIX=scenarios/
SCENE_EXPORT_PRESIGN_EXPIRE_SECONDS=900    # 契约固定：下载预签名 15 分钟
SCENE_EXPORT_MAX_SCENES=50                 # 契约 SceneExportRequest.scene_ids maxItems

# ---------- Carla 管理 API（4.4 节下发流程；⚠ 键名/子路径待人工确认 #9） ----------
CARLA_MANAGEMENT_ENDPOINT=                 # 例：http://carla-manager.hunter-core:2000
CARLA_INSTANCE_CREATE_PATH=/api/v1/instances
CARLA_INSTANCE_QUERY_PATH=/api/v1/instances
CARLA_SCENARIO_SUBMIT_PATH=/api/v1/instances/{sim_instance_id}/scenario
CARLA_REQUEST_TIMEOUT_SECONDS=5
CARLA_REQUEST_MAX_RETRIES=1

# ---------- 场景约束 / 缓存 / RBAC ----------
SCENE_DURATION_MAX_SECONDS=600
SCENE_PARAM_OVERRIDE_ALLOWED_PATHS=ego_vehicle,weather,duration,actors,events,success_criteria
SCENE_PARAM_OVERRIDE_FORBIDDEN_PATHS=map
SCENE_DETAIL_CACHE_TTL_SECONDS=3600        # cache:scene:{scene_id} TTL（契约 1 小时）
SCENE_DEFAULT_VERSION=1.0.0                # 创建场景默认 version
SCENE_DUPLICATE_NAME_SUFFIX=-copy
SCENE_DUPLICATE_MAX_ATTEMPTS=100
SCENE_READ_ROLES=admin,analyst,operator
SCENE_WRITE_ROLES=admin,operator
SCENE_EXECUTE_ROLES=admin,operator
SCENE_SCOPE_BY_CREATOR=false
SCENE_SCOPE_EXEMPT_ROLES=admin

# ---------- 实车场景自动提取（4.5 节：消费 analytics_result） ----------
ANALYTICS_RESULT_TOPIC=analytics_result
SCENE_EXTRACTION_GROUP_ID=scene-service-analytics-result
SCENE_EXTRACTION_CONSUMER_ENABLED=true
KAFKA_EXTRACTION_POLL_TIMEOUT_SECONDS=1
SCENE_EXTRACTION_CREATOR_ID=00000000-0000-0000-0000-000000000000   # ⚠ 系统账号 uuid 待确认
SCENE_EXTRACTION_DEFAULT_EGO_MODEL=HUNTER_SE
SCENE_EXTRACTION_MIN_SAFE_DISTANCE=1
SCENE_EXTRACTION_MAX_SPEED_DEVIATION=1
