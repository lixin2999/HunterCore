# =====================================================================
# HunterCore 单机部署包 — 环境变量模板（.env.example）
# 目标位置：/opt/hunter-core/.env（权限 600，已被 .gitignore 忽略，禁止提交）
#
# 使用：
#   $ cp infra/deploy/.env.example /opt/hunter-core/.env
#   $ bash /opt/hunter-core/scripts/gen-passwords.sh     # 生成随机强口令（幂等：已有值不覆盖）
#   $ chmod 600 /opt/hunter-core/.env
#
# 约束（不可更改）：
#   1) 变量名必须与 pydantic-settings 字段名一致（大小写不敏感，统一大写；无 env_prefix）
#      例：HunterBaseConfig.postgres_password ←→ POSTGRES_PASSWORD
#   2) 所有密码/密钥使用 CHANGE_ME_* 占位，真实值只存在于服务器 .env（或 K8s Secret）
#   3) SERVER_IP 必须是服务器真实 IP 或域名：Kafka 外部监听（9093/SASL_SSL）的
#      advertised.listeners 与 SRS WebRTC candidate 均依赖该值
#      ⚠ 双网卡/NAT 环境下，“浏览器可达的地址”可以不等于 SERVER_IP：那种情形单独给
#      SRS_CANDIDATE_IP（见 §7），否则 WHEP answer 里的 candidate 浏览器连不到、永远不出画
#   4) 阈值/端口/地址禁止写入业务代码，一律经本文件注入（系统约束第 16 条）
#   5) compose 读取的变量与业务服务读取的变量共用本文件（同一份注入源，避免两处漂移）
# =====================================================================

# ---------------------------------------------------------------------
# 0. 通用
# ---------------------------------------------------------------------
TZ=Asia/Shanghai
HUNTER_ENV=production              # 部署包标记（compose 标签/日志用途）：dev / staging / production
ENVIRONMENT=prod                   # 服务读取（Literal: dev|test|staging|prod）；staging/prod 会拒绝默认凭据
DEBUG=false
LOG_LEVEL=INFO
SERVER_IP=CHANGE_ME_SERVER_IP      # 例：192.168.1.10（Kafka 9093 / SRS WebRTC / 远程操控回调使用）
CORS_ORIGINS=CHANGE_ME_FRONTEND_ORIGIN   # 例：http://192.168.1.10（多来源逗号分隔，禁止 "*"）
API_HOST=0.0.0.0
VERSION=0.1.0                      # 镜像标签（构建参数 --build-arg VERSION）；禁止 latest
IMAGE_PREFIX=hunter                # 镜像名前缀：hunter/api-gateway:${VERSION}

# ---------------------------------------------------------------------
# 1. PostgreSQL 15 + TimescaleDB 2.13
#    契约：单实例（TimescaleDB 为 PG 扩展），库名 hunter_core，8 个服务 schema 隔离
#    （contracts/database/ddl/00_schemas.sql；表名 schema 限定，禁止跨服务直查）
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres             # compose 服务名（hunter-net 内 DNS 解析）
POSTGRES_PORT=5432                 # 容器内端口（连接串使用）
POSTGRES_USER=hunter
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=hunter_core
POSTGRES_HOST_PORT=5432            # 宿主机映射端口（仅 127.0.0.1，DBA 工具用）
# 时序表 vehicle_telemetry / algorithm_metrics 与业务表同库（见 sql/timescaledb.sql）
# ---- 可选加固：data-analytics 专用只读/写账号（默认单机复用上面的 POSTGRES 超级用户）----
# 生产建议先用 infra/deploy/sql/analytics-roles.sql 建角色（最小权限范围见 er.md §3 附注），再取消注释注入口令：
#   · RO：跨 schema 只读例外（pipeline/algorithm 块 SELECT data_collector.vehicle_telemetry / data_analytics.algorithm_metrics）
#   · RW：仅写本服务自身 schema data_analytics.algorithm_metrics（algorithm_metrics 落库消费者）
# ANALYTICS_RO_DB_USER=hunter_analytics_ro
# ANALYTICS_RO_DB_PASSWORD=CHANGE_ME_ANALYTICS_RO_PASSWORD
# ANALYTICS_RW_DB_USER=hunter_analytics_rw
# ANALYTICS_RW_DB_PASSWORD=CHANGE_ME_ANALYTICS_RW_PASSWORD
# ⚠ 若按设计文档拆分为独立时序实例，需先更新契约 + 6 个服务配置，再启用以下预留变量：
# TIMESCALE_HOST=timescale
# TIMESCALE_PORT=5433
# TIMESCALE_USER=hunter
# TIMESCALE_PASSWORD=CHANGE_ME_TIMESCALE_PASSWORD
# TIMESCALE_DB=hunter_core_ts
# Alembic / 离线迁移可用完整 DSN 覆盖（优先级：DATABASE_URL > POSTGRES_* > alembic.ini）
# DATABASE_URL=postgresql+asyncpg://hunter:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/hunter_core

# ---------------------------------------------------------------------
# 2. Apache Kafka 3.6（ZooKeeper 模式）
#    - 内部监听 9092：容器间通信（127.0.0.1:9092 映射给宿主机运维工具）
#    - 外部监听 9093：SASL_SSL + SCRAM-SHA-512，供车端接入（禁止 PLAINTEXT 对外）
# ---------------------------------------------------------------------
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_INTERNAL_LISTENER=INTERNAL
KAFKA_INTERNAL_LISTEN_PORT=9092
KAFKA_INTERNAL_SECURITY_PROTOCOL=SASL_PLAINTEXT   # 内网有认证；如需 TLS 改 SASL_SSL（并配置 CA）
KAFKA_EXTERNAL_LISTENER=EXTERNAL
KAFKA_EXTERNAL_LISTEN_PORT=9093
KAFKA_EXTERNAL_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USER=hunter-client                     # 平台侧（内部监听）SCRAM 账号
KAFKA_SASL_PASSWORD=CHANGE_ME_KAFKA_SASL_PASSWORD
KAFKA_SASL_VEHICLE_USER=hunter-vehicle            # 车端接入账号（每车可细化，见运维手册第 7 节）
KAFKA_SASL_VEHICLE_PASSWORD=CHANGE_ME_KAFKA_VEHICLE_PASSWORD
KAFKA_SSL_PASSWORD=CHANGE_ME_KAFKA_SSL_PASSWORD   # JKS keystore/truststore 口令（gen-kafka-certs.sh 生成）
KAFKA_SSL_CLIENT_AUTH=required                     # 严格 mTLS（G-01，设计文档 3.2.3/14.2）：车端 9093 必验客户端证书；仅本地联调可临时改 requested
KAFKA_CERTS_DIR=/opt/hunter-core/certs/kafka
# broker 证书附加 SAN 地址（逗号分隔，可选）：车端用哪个地址连 9093，证书 SAN 就必须含哪个地址
#   内网 + 公网双栈接入：KAFKA_CERT_SAN_IPS=101.201.150.237,192.168.31.35
#   域名接入：KAFKA_CERT_SAN_DNS=kafka.hunter-core.local
# 变更后重签（复用 CA，车端信任链不变）：sudo bash scripts/gen-kafka-certs.sh --broker-only
#   随后 restart kafka 加载新 keystore；改过本项 SERVER_IP 时需 up -d --force-recreate kafka（端口绑定与 listeners 重读）
KAFKA_CERT_SAN_IPS=
KAFKA_CERT_SAN_DNS=
KAFKA_LOG_DIRS=/data/kafka
KAFKA_HEAP_OPTS="-Xmx4g -Xms2g"                  # JVM 堆（与容器内存上限匹配，见第六章 §8）
KAFKA_NUM_PARTITIONS=12
KAFKA_DEFAULT_REPLICATION_FACTOR=1                # 单机单 broker（生产集群为 3）
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false             # Topic 必须按契约创建（禁止隐式建 Topic）
KAFKA_LOG_RETENTION_HOURS=168                     # 默认 7 天（内部 Topic 按契约单独覆盖）
KAFKA_AUTO_CREATE_TOPICS=false
# 业务服务连接（容器内）
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SSL_CAFILE=                                  # SASL_SSL 时填 /app/certs/kafka/ca.crt
KAFKA_CONTRACT_DIR=/app/contracts/kafka            # 契约目录（Topic/Schema 校验），compose 挂载
KAFKA_LOCAL_BUFFER_DIR=/app/data/kafka-buffer      # 断网落盘缓冲（契约固定上限 1GB）
KAFKA_LOCAL_BUFFER_ENABLED=true

# ---------------------------------------------------------------------
# 3. Redis 7（会话/缓存/分布式锁/限流；启用 AOF 持久化）
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379               # 宿主机映射（仅 127.0.0.1）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=noeviction  # 会话/锁不可被淘汰（与 K8s 清单一致）
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# ---------------------------------------------------------------------
# 4. MinIO（S3 兼容对象存储；7 个 Bucket 与生命周期见 object-storage.yaml 契约）
# ---------------------------------------------------------------------
MINIO_ROOT_USER=hunter-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD     # 长度 ≥8（自定义长度约束）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000           # 服务侧连接地址（容器内）
MINIO_SECURE=false                  # 单机内网无 TLS；启用 TLS 时置 true 并挂载证书
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY           # 服务账号（非 root，最小权限）
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
MINIO_DATA_DIR=/data/minio
# Bucket 名称（契约固定，不可更改）
MINIO_BUCKET_RAW_DATA=hunter-raw-data
MINIO_BUCKET_ROSBAG=hunter-rosbag
MINIO_BUCKET_VIDEO=hunter-video
MINIO_BUCKET_OTA_PACKAGES=hunter-ota-packages
MINIO_BUCKET_REPORTS=hunter-reports
MINIO_BUCKET_LOGS=hunter-logs
MINIO_BUCKET_SCENE_ASSETS=hunter-scene-assets
# V1.20.4 ingest-platform 数据湖层（契约固定，不可更改）
MINIO_BUCKET_DERIVED=hunter-derived           # 加层产物（对齐/切片/QC/富化）
MINIO_BUCKET_DATASET=hunter-datasets          # 训练数据集导出

# ---------------------------------------------------------------------
# 5. JWT / 认证（Access 2h + Refresh 7d，设计文档「安全机制」）
# ---------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY     # ≥32 字节随机串（HS256）；gen-passwords.sh 生成
# G-06（设计文档 14.1）：admin 初始口令由 gen-passwords.sh 随机生成（废除固定 Hunter@2025）；
# 首次登录强制修改（must_change_password=true）；未生成时 admin 为禁用+占位哈希
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GATEWAY_HMAC_SECRET=CHANGE_ME_GATEWAY_HMAC_SECRET   # G-02：网关→后端身份头 X-Internal-MAC 签名密钥（≥32 字节随机串，网关与 5 后端服务共用）
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30          # = 1800 秒（Access Token 30min，G-04① 收紧，原 2h）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7             # = 604800 秒（Refresh Token 7d）
JWT_ISSUER=hunter-platform
PASSWORD_BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# 6. api-gateway 上游地址（hunter-net 服务名通信；网关路由表 /api/v1/**）
# ---------------------------------------------------------------------
SCENE_SERVICE_URL=http://scene-service:8081
DATA_COLLECTOR_SERVICE_URL=http://data-collector:8082
DATA_ANALYTICS_SERVICE_URL=http://data-analytics:8083
OTA_SERVICE_URL=http://ota-service:8084
REMOTE_CONTROL_SERVICE_URL=http://remote-control:8085
VEHICLE_SERVICE_URL=http://vehicle-service:8086        # 车辆台账与一键接入 provisioning（契约 openapi/vehicle-service.yaml）
USER_SERVICE_URL=                           # user-service 尚未交付（网关路由预留），留空
PROXY_CONNECT_TIMEOUT_SECONDS=5
PROXY_TIMEOUT_SECONDS=30                    # OTA 发布接口为性能例外（≥300s，服务内单独覆盖）
# 限流（附录 D：全局限流 10000 QPS / 单用户 100 QPS / 单 IP 200 QPS）
RATE_LIMIT_GLOBAL_QPS=10000
RATE_LIMIT_PER_USER_QPS=100
RATE_LIMIT_PER_IP_QPS=200
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_WINDOW_SECONDS=900

# ---------------------------------------------------------------------
# 7. remote-control + SRS 5.0（WebRTC/RTMP；控制指令固定 20Hz）
# ---------------------------------------------------------------------
RC_PUBLIC_WS_BASE_URL=ws://CHANGE_ME_SERVER_IP/ws/remote   # HTTPS 环境改 wss://（TLS 1.3）
RC_SRS_APP=remote_control
RC_SRS_STREAM_PREFIX=hunter
# SRS 媒体地址均为**基址**（不含 app/stream）：remote-control 后端会按会话拼
# ?app=remote_control&stream=hunter_{vehicle_id}_{session_id} 后下发。
# ⚠ 这些地址由浏览器/车端直接访问，必须用对外 SERVER_IP（非容器内主机名 srs）。
# V1.21.1：WHEP/WHIP 信令改走同源 :80/rtc/（web-portal nginx 反代 → srs:9090），
#   规避浏览器跨源 CSP connect-src/CORS 拦截（直连 :9090 会报 Failed to fetch）；
#   V1.21.3（实机验证同源链路后）：compose 中 srs 9090 映射已收回 127.0.0.1，仅供宿主机诊断/健康检查。
RC_SRS_RTMP_URL=rtmp://CHANGE_ME_SERVER_IP:1935/remote_control   # 车端/模拟器推流（需车端可达）
RC_SRS_WHEP_URL=http://CHANGE_ME_SERVER_IP/rtc/v1/whep/          # 浏览器 WHEP 拉流（同源反代，经 :80）
RC_SRS_WHIP_URL=http://CHANGE_ME_SERVER_IP/rtc/v1/whip/          # 可选：WHIP 推流信令（同源反代，无 ffmpeg 回退路径）
# ⚠ V1.21.10：局域网同网段部署保持为空——浏览器 ICE-lite 直连 host candidate 即可；
#   切勿指向 SRS 的 8000/udp（那是媒体端口不是 STUN 服务，会干扰 ICE 状态机导致 DTLS 永不开始）。
RC_STUN_URLS=
RC_TURN_URLS=                                                # 跨网段/NAT 后启用：turn:<可达IP>:3478?transport=udp（需先部 coturn）
RC_TURN_USERNAME=
RC_TURN_SHARED_SECRET=                                       # 敏感：仅服务器 .env 保存（与 coturn use-auth-secret 一致）
RC_MAX_SPEED_MPS=2.0                     # 远程操控限速上限（不可上调 >2.0 m/s）
RC_COMMAND_HZ=20                         # 控制指令频率（固定 20Hz）
RC_COMMAND_INTERVAL_MS=50                # 指令间隔（固定 50ms）
RC_STOP_ON_TIMEOUT_MS=500                # 指令超时自动减速停车（>500ms 未收到指令）
RC_MAX_COMMAND_RATE_HZ=25                # 单会话帧率上限（超出丢弃并计数）
RC_SESSION_LOCK_TTL_S=30                 # 会话互斥锁（同一车辆同时仅一名操作员）
RC_VIDEO_WIDTH=1280
RC_VIDEO_HEIGHT=720
RC_VIDEO_FPS=30
RC_VIDEO_BITRATE_MIN_KBPS=2048
RC_VIDEO_BITRATE_MAX_KBPS=4096
SRS_RTMP_PORT=1935
SRS_RTC_UDP_PORT=8000
SRS_HTTP_API_PORT=9090
SRS_HTTP_API_HOST_PORT=9090              # 宿主机映射（V1.21.3 起仅绑 127.0.0.1：信令已同源 /rtc/ 反代，此端口只供宿主机健康检查/诊断）
# SRS rtc_server.candidate：写进 srs.conf 的 WebRTC host candidate，由 install.sh Step 4 的
#   ensure_srs_conf 幂等写入（占位符与旧 IP 都会被改写；改完需 up -d --force-recreate srs）。
# ⚠ 它必须是「浏览器能直达的地址」，而不是「服务器自己的地址」：双网卡/公网+局域网共存的机器上，
#   两者不一致时本变量要显式填浏览器侧实际访问的那个 IP（填错的症状：信令 201、流也在 SRS 上，
#   但画面永远 0.0 fps / 0.00 Mbps —— 与“车端未推流”完全同现象）。留空则回退 SERVER_IP。
#   跨 NAT 且浏览器不可直达时，不要改本项，而是补 RC_TURN_URLS/RC_TURN_SHARED_SECRET。
SRS_CANDIDATE_IP=                        # 例：192.168.1.10（局域网访问就填局域网 IP）；留空=跟随 SERVER_IP

# ---------------------------------------------------------------------
# 8. Flink 2.1（JobManager/TaskManager；实时分析作业）
# ---------------------------------------------------------------------
FLINK_UI_HOST_PORT=8088                  # ⚠ 容器内 8081 与 scene-service 端口冲突，宿主机改用 8088
# TM 槽位数：需 ≥ 常驻作业数（V1.21.2：2→4）。三作业一组一作业、并行度默认 1 各占 1 槽；
# 旧值 2 使 data_quality_monitor_ingest_latency 永远排不上 → RESTARTING 循环、看板入库延迟 P95 不出数。
FLINK_TASK_SLOTS=4
# FLINK_PARALLELISM 为幽灵变量（compose/代码均无人读取，V1.21.2 删除）：作业并行度由代码默认（1）决定；
# 如需调并行度用 `flink run -p N`（submit-flink-jobs.sh）或改作业代码 set_parallelism。
FLINK_JM_HEAP_MB=1600
FLINK_TM_HEAP_MB=4096
# 检查点周期（毫秒）：读取方是作业代码 hunter_flink.checkpointing（compose flink-jm/flink-tm 透传）。
# ⚠ V1.19.15 改名：原写 `FLINK_CHECKPOINT_INTERVAL_MS`——该拼写在 compose/代码里**无人读取**，
#   调了不报错但完全不生效（幽灵变量）；位点只在检查点提交，本值失灵等于消费组永不出现。
FLINK_CHECKPOINTING_INTERVAL_MS=10000
FLINK_JM_URL=http://flink-jm:8081        # data-analytics 访问 JM（容器内端口）

# ---------------------------------------------------------------------
# 9. 业务服务端口（容器内固定 8080-8085；宿主机映射仅 127.0.0.1，8080 对外）
# ---------------------------------------------------------------------
API_GATEWAY_PORT=8080
SCENE_SERVICE_PORT=8081
DATA_COLLECTOR_PORT=8082
DATA_ANALYTICS_PORT=8083
OTA_SERVICE_PORT=8084
REMOTE_CONTROL_PORT=8085
VEHICLE_SERVICE_PORT=8086
INGEST_PLATFORM_PORT=8089                # V1.20.4 数据消费/解析服务（容器内 8089，宿主映射仅 127.0.0.1）
WEB_PORT=80

# ---------------------------------------------------------------------
# 9b. vehicle-service 私有配置（契约 x-hunter-service.required_env / optional_env）
#     控制面服务：Kafka AdminClient（KIP-95 SCRAM + Topic） + openssl 子进程签发每车客户端证书
# ---------------------------------------------------------------------
# CA 文件在容器内的只读挂载位置（compose 已固定 /srv/kafka-ca），宿主侧对应 ./certs/kafka（gen-kafka-certs.sh 产物）
KAFKA_CA_KEY_PATH=/srv/kafka-ca/ca-key.pem
KAFKA_CA_CERT_PATH=/srv/kafka-ca/ca-cert.pem
# 每车证书持久化目录（vehicle-service 写入；宿主机 ${DATA_DIR}/vehicle-certs，gid 10001 可写）
VEHICLE_CERTS_DIR=/app/data/vehicle-certs
# 证书有效期（与 CA 同寿 3650 天；不建议缩短，车端信任链同步成本较高）
VEHICLE_CERT_RETENTION_DAYS=3650
# AdminClient 元数据同步上限（Kafka 内部控制面超时，单位 ms）
KAFKA_ADMIN_TIMEOUT_MS=10000
# 车端 kafka.properties 中 bootstrap 主机（默认同 SERVER_IP，需为车端可反向解析地址）
# 车端外部 Kafka 监听端口（与 compose KAFKA_EXTERNAL_LISTEN_PORT 保持一致）
KAFKA_EXTERNAL_PORT=9093

# ---------------------------------------------------------------------
# 9c. ingest-platform 私有配置（服务端数据消费/解析/处理，V1.20.4）
#     订阅 vehicle.bag.*/vehicle.agent.*，生产 platform.*/ingest.dlt（DLT 死信）
#     连接密钥复用前文：POSTGRES_*/KAFKA_*/REDIS_*/MINIO_*（§3/§4）、GATEWAY_HMAC_SECRET（§5，fail-closed）
# ---------------------------------------------------------------------
# 解析产物隔离桶账号（可选）：留空回退 §4 的 MINIO_ACCESS_KEY/MINIO_SECRET_KEY；
# 需将 parsed 写入与 raw 读取分离时才单独配置
MINIO_PARSED_ACCESS_KEY=
MINIO_PARSED_SECRET_KEY=
# 死信队列（DLT）：解析/校验失败的信封落入 ingest.dlt，可由 g.ingest.dlt-replay 组回放
DLT_ENABLED=true
DLT_TOPIC=ingest.dlt
# 运营告警 Webhook（可选）：留空则仅日志告警；配置后 agent.alert/QC 失败等推送到该地址
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------
# 10. 备份与日志
# ---------------------------------------------------------------------
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
LOG_DIR=/var/log/hunter-core


