# =====================================================================
# HunterCore 单机部署包 — 环境变量模板（.env.example）
# 目标位置：/opt/hunter-edge/.env（权限 600，已被 .gitignore 忽略，禁止提交）
#
# 使用：
#   $ cp infra/deploy/.env.example /opt/hunter-edge/.env
#   $ bash /opt/hunter-edge/scripts/gen-passwords.sh     # 生成随机强口令（幂等：已有值不覆盖）
#   $ chmod 600 /opt/hunter-edge/.env
#
# 约束（不可更改）：
#   1) 变量名必须与 pydantic-settings 字段名一致（大小写不敏感，统一大写；无 env_prefix）
#      例：HunterBaseConfig.postgres_password ←→ POSTGRES_PASSWORD
#   2) 所有密码/密钥使用 CHANGE_ME_* 占位，真实值只存在于服务器 .env（或 K8s Secret）
#   3) SERVER_IP 必须是服务器真实 IP 或域名：Kafka 外部监听（9093/SASL_SSL）的
#      advertised.listeners 与 SRS WebRTC candidate 均依赖该值
#   4) 阈值/端口/地址禁止写入业务代码，一律经本文件注入（系统约束第 16 条）
#   5) compose 读取的变量与业务服务读取的变量共用本文件（同一份注入源，避免两处漂移）
# =====================================================================

# ---------------------------------------------------------------------
# 0. 通用
# ---------------------------------------------------------------------
TZ=Asia/Shanghai
HUNTER_ENV=production              # 部署包标记（compose 标签/日志用途）：dev / staging / production
ENVIRONMENT=prod                   # 服务读取（Literal: dev|test|staging|prod）；staging/prod 会拒绝默认凭据
DEBUG=false
LOG_LEVEL=INFO
SERVER_IP=CHANGE_ME_SERVER_IP      # 例：192.168.1.10（Kafka 9093 / SRS WebRTC / 远程操控回调使用）
CORS_ORIGINS=CHANGE_ME_FRONTEND_ORIGIN   # 例：http://192.168.1.10（多来源逗号分隔，禁止 "*"）
API_HOST=0.0.0.0
VERSION=0.1.0                      # 镜像标签（构建参数 --build-arg VERSION）；禁止 latest
IMAGE_PREFIX=hunter                # 镜像名前缀：hunter/api-gateway:${VERSION}

# ---------------------------------------------------------------------
# 1. PostgreSQL 15 + TimescaleDB 2.13
#    契约：单实例（TimescaleDB 为 PG 扩展），库名 hunter_core，8 个服务 schema 隔离
#    （contracts/database/ddl/00_schemas.sql；表名 schema 限定，禁止跨服务直查）
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres             # compose 服务名（hunter-net 内 DNS 解析）
POSTGRES_PORT=5432                 # 容器内端口（连接串使用）
POSTGRES_USER=hunter
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=hunter_core
POSTGRES_HOST_PORT=5432            # 宿主机映射端口（仅 127.0.0.1，DBA 工具用）
# 时序表 vehicle_telemetry / algorithm_metrics 与业务表同库（见 sql/timescaledb.sql）
# ⚠ 若按设计文档拆分为独立时序实例，需先更新契约 + 6 个服务配置，再启用以下预留变量：
# TIMESCALE_HOST=timescale
# TIMESCALE_PORT=5433
# TIMESCALE_USER=hunter
# TIMESCALE_PASSWORD=CHANGE_ME_TIMESCALE_PASSWORD
# TIMESCALE_DB=hunter_core_ts
# Alembic / 离线迁移可用完整 DSN 覆盖（优先级：DATABASE_URL > POSTGRES_* > alembic.ini）
# DATABASE_URL=postgresql+asyncpg://hunter:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/hunter_core

# ---------------------------------------------------------------------
# 2. Apache Kafka 3.6（ZooKeeper 模式）
#    - 内部监听 9092：容器间通信（127.0.0.1:9092 映射给宿主机运维工具）
#    - 外部监听 9093：SASL_SSL + SCRAM-SHA-512，供车端接入（禁止 PLAINTEXT 对外）
# ---------------------------------------------------------------------
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_INTERNAL_LISTENER=INTERNAL
KAFKA_INTERNAL_LISTEN_PORT=9092
KAFKA_INTERNAL_SECURITY_PROTOCOL=SASL_PLAINTEXT   # 内网有认证；如需 TLS 改 SASL_SSL（并配置 CA）
KAFKA_EXTERNAL_LISTENER=EXTERNAL
KAFKA_EXTERNAL_LISTEN_PORT=9093
KAFKA_EXTERNAL_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USER=hunter-client                     # 平台侧（内部监听）SCRAM 账号
KAFKA_SASL_PASSWORD=CHANGE_ME_KAFKA_SASL_PASSWORD
KAFKA_SASL_VEHICLE_USER=hunter-vehicle            # 车端接入账号（每车可细化，见运维手册第 7 节）
KAFKA_SASL_VEHICLE_PASSWORD=CHANGE_ME_KAFKA_VEHICLE_PASSWORD
KAFKA_SSL_PASSWORD=CHANGE_ME_KAFKA_SSL_PASSWORD   # JKS keystore/truststore 口令（gen-kafka-certs.sh 生成）
KAFKA_CERTS_DIR=/opt/hunter-edge/certs/kafka
KAFKA_LOG_DIRS=/data/kafka
KAFKA_HEAP_OPTS="-Xmx4g -Xms2g"                  # JVM 堆（与容器内存上限匹配，见第六章 §8）
KAFKA_NUM_PARTITIONS=12
KAFKA_DEFAULT_REPLICATION_FACTOR=1                # 单机单 broker（生产集群为 3）
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false             # Topic 必须按契约创建（禁止隐式建 Topic）
KAFKA_LOG_RETENTION_HOURS=168                     # 默认 7 天（内部 Topic 按契约单独覆盖）
KAFKA_AUTO_CREATE_TOPICS=false
# 业务服务连接（容器内）
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SSL_CAFILE=                                  # SASL_SSL 时填 /app/certs/kafka/ca.crt
KAFKA_CONTRACT_DIR=/app/contracts/kafka            # 契约目录（Topic/Schema 校验），compose 挂载
KAFKA_LOCAL_BUFFER_DIR=/app/data/kafka-buffer      # 断网落盘缓冲（契约固定上限 1GB）
KAFKA_LOCAL_BUFFER_ENABLED=true

# ---------------------------------------------------------------------
# 3. Redis 7（会话/缓存/分布式锁/限流；启用 AOF 持久化）
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379               # 宿主机映射（仅 127.0.0.1）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=noeviction  # 会话/锁不可被淘汰（与 K8s 清单一致）
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# ---------------------------------------------------------------------
# 4. MinIO（S3 兼容对象存储；7 个 Bucket 与生命周期见 object-storage.yaml 契约）
# ---------------------------------------------------------------------
MINIO_ROOT_USER=hunter-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD     # 长度 ≥8（自定义长度约束）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000           # 服务侧连接地址（容器内）
MINIO_SECURE=false                  # 单机内网无 TLS；启用 TLS 时置 true 并挂载证书
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY           # 服务账号（非 root，最小权限）
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
MINIO_DATA_DIR=/data/minio
# Bucket 名称（契约固定，不可更改）
MINIO_BUCKET_RAW_DATA=hunter-raw-data
MINIO_BUCKET_ROSBAG=hunter-rosbag
MINIO_BUCKET_VIDEO=hunter-video
MINIO_BUCKET_OTA_PACKAGES=hunter-ota-packages
MINIO_BUCKET_REPORTS=hunter-reports
MINIO_BUCKET_LOGS=hunter-logs
MINIO_BUCKET_SCENE_ASSETS=hunter-scene-assets

# ---------------------------------------------------------------------
# 5. JWT / 认证（Access 2h + Refresh 7d，设计文档「安全机制」）
# ---------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY     # ≥32 字节随机串（HS256）；gen-passwords.sh 生成
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120         # = 7200 秒（Access Token 2h）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7             # = 604800 秒（Refresh Token 7d）
JWT_ISSUER=hunter-platform
PASSWORD_BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# 6. api-gateway 上游地址（hunter-net 服务名通信；网关路由表 /api/v1/**）
# ---------------------------------------------------------------------
SCENE_SERVICE_URL=http://scene-service:8081
DATA_COLLECTOR_SERVICE_URL=http://data-collector:8082
DATA_ANALYTICS_SERVICE_URL=http://data-analytics:8083
OTA_SERVICE_URL=http://ota-service:8084
REMOTE_CONTROL_SERVICE_URL=http://remote-control:8085
VEHICLE_SERVICE_URL=                        # vehicle-service 尚未交付（网关路由预留），留空
USER_SERVICE_URL=                           # user-service 尚未交付（网关路由预留），留空
PROXY_CONNECT_TIMEOUT_SECONDS=5
PROXY_TIMEOUT_SECONDS=30                    # OTA 发布接口为性能例外（≥300s，服务内单独覆盖）
# 限流（附录 D：全局限流 10000 QPS / 单用户 100 QPS / 单 IP 200 QPS）
RATE_LIMIT_GLOBAL_QPS=10000
RATE_LIMIT_PER_USER_QPS=100
RATE_LIMIT_PER_IP_QPS=200
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_WINDOW_SECONDS=900

# ---------------------------------------------------------------------
# 7. remote-control + SRS 5.0（WebRTC/RTMP；控制指令固定 20Hz）
# ---------------------------------------------------------------------
RC_PUBLIC_WS_BASE_URL=ws://CHANGE_ME_SERVER_IP/ws/remote   # HTTPS 环境改 wss://（TLS 1.3）
RC_SRS_APP=remote_control
RC_SRS_STREAM_PREFIX=hunter
RC_SRS_RTMP_URL=rtmp://srs:1935/remote_control              # 车端推流（容器内地址）
RC_SRS_WHEP_URL=http://srs:9090/rtc/v1/whep/                # 浏览器播放信令
RC_SRS_WHIP_URL=http://srs:9090/rtc/v1/whip/                # 可选：WHIP 推流信令
RC_STUN_URLS=stun:CHANGE_ME_SERVER_IP:8000                  # ⚠ 端口需与 SRS rtc_server(8000/udp) 一致
RC_TURN_URLS=                                                # 生产跨 NAT 建议补 TURN（需人工确认）
RC_TURN_USERNAME=
RC_TURN_SHARED_SECRET=                                       # 敏感：仅服务器 .env 保存
RC_MAX_SPEED_MPS=2.0                     # 远程操控限速上限（不可上调 >2.0 m/s）
RC_COMMAND_HZ=20                         # 控制指令频率（固定 20Hz）
RC_COMMAND_INTERVAL_MS=50                # 指令间隔（固定 50ms）
RC_STOP_ON_TIMEOUT_MS=500                # 指令超时自动减速停车（>500ms 未收到指令）
RC_MAX_COMMAND_RATE_HZ=25                # 单会话帧率上限（超出丢弃并计数）
RC_SESSION_LOCK_TTL_S=30                 # 会话互斥锁（同一车辆同时仅一名操作员）
RC_VIDEO_WIDTH=1280
RC_VIDEO_HEIGHT=720
RC_VIDEO_FPS=30
RC_VIDEO_BITRATE_MIN_KBPS=2048
RC_VIDEO_BITRATE_MAX_KBPS=4096
SRS_RTMP_PORT=1935
SRS_RTC_UDP_PORT=8000
SRS_HTTP_API_PORT=9090
SRS_HTTP_API_HOST_PORT=9090              # 宿主机映射（仅 127.0.0.1）

# ---------------------------------------------------------------------
# 8. Flink 1.18（JobManager/TaskManager；实时分析作业）
# ---------------------------------------------------------------------
FLINK_UI_HOST_PORT=8088                  # ⚠ 容器内 8081 与 scene-service 端口冲突，宿主机改用 8088
FLINK_TASK_SLOTS=2
FLINK_PARALLELISM=2
FLINK_JM_HEAP_MB=1600
FLINK_TM_HEAP_MB=4096
FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_JM_URL=http://flink-jm:8081        # data-analytics 访问 JM（容器内端口）

# ---------------------------------------------------------------------
# 9. 业务服务端口（容器内固定 8080-8085；宿主机映射仅 127.0.0.1，8080 对外）
# ---------------------------------------------------------------------
API_GATEWAY_PORT=8080
SCENE_SERVICE_PORT=8081
DATA_COLLECTOR_PORT=8082
DATA_ANALYTICS_PORT=8083
OTA_SERVICE_PORT=8084
REMOTE_CONTROL_PORT=8085
WEB_PORT=80

# ---------------------------------------------------------------------
# 10. 备份与日志
# ---------------------------------------------------------------------
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
LOG_DIR=/var/log/hunter-edge


