# ============================================================
# HunterCore .gitignore —— 仅追踪源码/契约/配置等必要文件
# 本地文档（docs/、release.md）按开发规则：只更新、不追踪
# ============================================================

# ===== Python：缓存与构建产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
.cache/

# ===== Python：虚拟环境 =====
.venv/
venv/
ENV/
env.bak/
venv.bak/

# ===== Python：测试与工具缓存 =====
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage.lcov
htmlcov/
test-results/
junit*.xml

# ===== Node / 前端 =====
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo
.vite/
frontend/.npm-cache/

# ===== Flink / Spark：Java 构建与本地产物 =====
target/
*.class
spark-warehouse/
metastore_db/
spark-events/

# ===== Docker / 本地运行时数据 =====
docker-compose.override.yml
infra/docker/data/
*.pid

# ===== 本地数据库 / 二进制数据 =====
*.db
*.sqlite
*.sqlite3
*.dump
*.core

# ===== 日志 / 临时文件 =====
*.log
*.log.*
logs/
*.tmp
*.bak
*.orig
*.rej
~$*

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.sln
*.user
.fleet/
.zed/
*.sublime-workspace
*.sublime-project

# ===== AI 工具本地配置与会话产物 =====
.clinerules
.cursor/
.cursorrules
.aider*
.windsurf/
.continue/
.codeium/
.claude/

# ===== 环境变量（仅提交 .env.example，禁止提交敏感配置） =====
.env
.env.local
.env.*.local

# ===== OS =====
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
Icon?
.Spotlight-V100/
.Trashes/

# ===== 本地文档（按开发规则：每次只更新不提交） =====
docs/
release.md
# ===== 单机部署包（infra/deploy）：模板与 SQL 产物入库；真实密钥/证书/数据禁止入库 =====
infra/deploy/.env
infra/deploy/.env.bak*
infra/deploy/certs/*
!infra/deploy/certs/README.md
infra/deploy/data/
infra/deploy/backups/
*.pem
*.crt
*.cer
*.keystore
*.truststore
*.p12
*.pfx


# ===== K8s 敏感配置（仅提交 *.example.yaml 模板，禁止提交真实密钥/证书） =====
infra/k8s/**/02-secret.yaml
**/secret.yaml
**/secret-*.yaml
**/*-secrets.yaml
!infra/k8s/base/02-secret.example.yaml
*.key
*.csr
*.jks
ca.crt


# ===== 本地文档（开发规则：docs/ 开发文档与 release.md 只更新、不追踪） =====
docs/
release.md
