# ===== 开发环境（vite dev server 反向代理到 api-gateway:8080）=====
# 所有可调参数均通过环境变量注入，禁止硬编码（系统约束第 16 条）

# 应用标题（浏览器标签 + 顶栏）
VITE_APP_TITLE=HunterCore 运营管理后台

# 后端基础路径：相对路径，由 dev server 代理 / Ingress 同源转发
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws

# 开发代理目标（网关统一入口）
VITE_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5173

# 轮询间隔（毫秒）
# ⚠ 附录 D 限流：GET /api/v1/data/telemetry 单用户 20 QPS → 单车辆最快 2000ms 轮询
VITE_POLL_DASHBOARD_MS=5000
VITE_POLL_TELEMETRY_MS=2000
VITE_POLL_SESSION_MS=1000

# 远程操控 UI 提示限幅（真实限幅由服务端执行：RC_MAX_SPEED_MPS / RC_MAX_STEER_RAD）
# ⚠ RC_MAX_STEER_RAD 待契约 pending #18 确认，此处仅为 UI 归一化提示值
VITE_RC_MAX_SPEED_MPS=2.0
VITE_RC_MAX_STEER_RAD=0.6

# 操控历史查询最大跨度（天）——契约 RC_HISTORY_QUERY_MAX_RANGE_DAYS 默认 31
VITE_RC_HISTORY_MAX_RANGE_DAYS=31
