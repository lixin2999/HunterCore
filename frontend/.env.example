# ===== HunterEdge 前端环境变量模板（复制为 .env.development / .env.production 后修改）=====
# 禁止在此文件中填入任何密钥/证书/Token（日志脱敏与仓库安全要求）

VITE_APP_TITLE=HunterEdge 运营管理后台
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
VITE_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5173
VITE_POLL_DASHBOARD_MS=5000
VITE_POLL_TELEMETRY_MS=2000
VITE_POLL_SESSION_MS=1000
VITE_RC_MAX_SPEED_MPS=2.0
VITE_RC_MAX_STEER_RAD=0.6
VITE_RC_HISTORY_MAX_RANGE_DAYS=31
